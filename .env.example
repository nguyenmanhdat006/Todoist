# Sao chép thành .env.local (không đưa lên git) rồi điền giá trị thật.
# Lấy từ Neon: Dashboard → Connect → Connection string (nên dùng branch "dev" khi chạy ở máy).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cổng API khi chạy ở máy (npm run dev:api), mặc định 3001
# API_PORT=3001

# Quên mật khẩu: gửi email qua SMTP. Với Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password).
# SMTP_USER=ban@gmail.com
# SMTP_PASS=mat-khau-ung-dung-16-ky-tu
# MAIL_FROM="Quản lý công việc" <ban@gmail.com>
# APP_URL=https://todoist-website-omega.vercel.app
# Khi phát triển ở máy: chỉ in email (kèm liên kết đặt lại) ra cửa sổ chạy API, không gửi thật
# MAIL_MODE=log
