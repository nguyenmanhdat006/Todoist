{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todoist-website-omega.vercel.app/schema/task-management-export-v2.json",
  "title": "Task management export (schemaVersion 2)",
  "description": "File JSON xuất từ app Quản lý công việc. Xem docs/export-format.md.",
  "type": "object",
  "required": ["format", "schemaVersion", "exportedAt", "timezone", "columns", "tasks"],
  "properties": {
    "format": { "const": "task-management-export" },
    "schemaVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "description": "IANA, ví dụ Asia/Ho_Chi_Minh" },
    "settings": {
      "type": "object",
      "properties": {
        "lang": { "enum": ["vi", "en"] },
        "theme": { "enum": ["system", "light", "dark"] },
        "view": { "enum": ["kanban", "list", "calendar"] },
        "calendarMode": { "enum": ["month", "week", "day"] },
        "calendarHiddenTags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "columns": { "type": "integer", "minimum": 0 },
        "tags": { "type": "integer", "minimum": 0 },
        "tasks": { "type": "integer", "minimum": 0 },
        "filters": { "type": "integer", "minimum": 0 },
        "reminders": { "type": "integer", "minimum": 0 }
      }
    },
    "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
    "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
    "reminders": { "type": "array", "items": { "$ref": "#/$defs/reminder" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "column": {
      "type": "object",
      "required": ["id", "title", "color", "isDone", "builtin", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/color" },
        "isDone": { "type": "boolean" },
        "builtin": { "enum": ["overdue", "todo", "doing", "review", "done", null] },
        "position": { "type": "integer", "minimum": 0 },
        "cardColor": { "anyOf": [{ "enum": ["status", "none"] }, { "$ref": "#/$defs/color" }] }
      }
    },
    "tag": {
      "type": "object",
      "required": ["name", "color", "preset", "taskCount"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/color" },
        "preset": { "type": ["string", "null"] },
        "taskCount": { "type": "integer", "minimum": 0 }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "columnId", "position", "title", "note", "priority", "dueDate", "startTime", "endTime", "tags", "createdAt", "updatedAt", "completedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "columnId": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "priority": { "enum": ["high", "normal", "low"] },
        "dueDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "startTime": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "endTime": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "autoOverdueFor": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "prevColumnId": { "type": ["string", "null"] },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
        "assignees": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "assigneeId": { "type": ["string", "null"], "format": "uuid" },
        "number": { "type": ["integer", "null"], "minimum": 1 },
        "creatorId": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "filter": {
      "type": "object",
      "required": ["id", "name", "priorities", "tags", "columnIds", "due", "hideDone"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "labelKey": { "enum": ["prio.high", "filter.overdue"] },
        "priorities": { "type": "array", "items": { "enum": ["high", "normal", "low"] } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "columnIds": { "type": "array", "items": { "type": "string" } },
        "due": { "enum": ["any", "overdue", "today", "week", "none"] },
        "hideDone": { "type": "boolean" }
      }
    },
    "reminder": {
      "type": "object",
      "required": ["id", "taskId", "at", "createdAt", "read"],
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      }
    }
  }
}
